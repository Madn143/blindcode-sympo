rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }

    match /event_settings/current {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /round1_questions/{questionId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /round2_questions/{questionId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if signedIn() && (request.auth.uid == userId || isAdmin());
    }
    match /round1_answers/{answerId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /round2_answers/{answerId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }
  }
}